{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [".cache/.eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "TEST_DATABASE_URL_MIGRATE"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "PORT",
    "DATABASE_URL",
    "DATABASE_URL_MIGRATE",
    "SECRETS_MANAGER",
    "DOPPLER_TOKEN",
    "DOPPLER_PROJECT",
    "DOPPLER_CONFIG",
    "PRIVY_APP_ID",
    "PRIVY_APP_SECRET",
    "PRIVY_JWT_VERIFICATION_KEY",
    "PRIVY_MANAGEMENT_QUORUM_ID",
    "PRIVY_RUNTIME_SIGNER_ID",
    "WALLET_PER_TRANSACTION_MAX_USDC",
    "BASE_RPC_URL",
    "NEAR_NETWORK",
    "NEAR_RPC_URL",
    "NEAR_RELAYER_PRIVY_WALLET_ID",
    "NEAR_RELAYER_ACCOUNT_ID",
    "ONECLICK_BASE_URL",
    "ONECLICK_API_KEY",
    "FASTNEAR_TRANSFERS_URL",
    "FASTNEAR_API_KEY",
    "ALCHEMY_WEBHOOK_ID",
    "ALCHEMY_WEBHOOK_SIGNING_KEY",
    "ALCHEMY_NOTIFY_TOKEN",
    "LITHIC_API_KEY",
    "LITHIC_WEBHOOK_SECRET",
    "LITHIC_ASA_SECRET",
    "CARD_REVEAL_ORIGIN",
    "PAYCREST_API_KEY",
    "PAYCREST_BASE_URL",
    "PAYCREST_API_SECRET",
    "PRIVY_RUNTIME_AUTHORIZATION_KEY",
    "WEBAUTHN_RP_ID",
    "WEBAUTHN_ORIGINS",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "APP_INSTALL_URL",
    "TELNYX_API_KEY",
    "TELNYX_VERIFY_PROFILE_ID",
    "EXPO_ACCESS_TOKEN",
    "ANTHROPIC_API_KEY",
    "RECEIPT_MODEL",
    "ADMIN_APP_ORIGINS",
    "DASHBOARD_ORIGINS",
    "ZOHO_CLIENT_ID",
    "ZOHO_CLIENT_SECRET",
    "ZOHO_REDIRECT_URI",
    "ACCOUNTING_TOKEN_KEY"
  ]
}
