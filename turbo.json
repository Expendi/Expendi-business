{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [".cache/.eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "TEST_DATABASE_URL_MIGRATE"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "PORT",
    "DATABASE_URL",
    "DATABASE_URL_MIGRATE",
    "SECRETS_MANAGER",
    "DOPPLER_TOKEN",
    "DOPPLER_PROJECT",
    "DOPPLER_CONFIG",
    "PRIVY_APP_ID",
    "PRIVY_APP_SECRET",
    "PRIVY_JWT_VERIFICATION_KEY",
    "PRIVY_MANAGEMENT_QUORUM_ID",
    "PRIVY_RUNTIME_SIGNER_ID",
    "WALLET_PER_TRANSACTION_MAX_USDC",
    "BASE_RPC_URL",
    "ALCHEMY_WEBHOOK_ID",
    "ALCHEMY_WEBHOOK_SIGNING_KEY",
    "ALCHEMY_NOTIFY_TOKEN",
    "PAYCREST_API_KEY",
    "PAYCREST_BASE_URL",
    "PAYCREST_API_SECRET",
    "PRIVY_RUNTIME_AUTHORIZATION_KEY",
    "WEBAUTHN_RP_ID",
    "WEBAUTHN_ORIGINS"
  ]
}
