  subgraph Services["Services"]
    AUTHS["auth · staff-auth"]
    WALLET["wallet"]
    PAYOUT["payout"]
    PAYMENTS["payments · withdrawal · bills · payees"]
    OVER["overview · alerts"]
    EXP["expenses"]
    PV["phone-verification"]
    MAILERS["membership · approval · payees · payroll<br/>phone-verification · notification · export · alerts"]
    NOTIF["notification"]
    FILES["expenses · bills · export · zoho"]
    ZOHOS["zoho"]
