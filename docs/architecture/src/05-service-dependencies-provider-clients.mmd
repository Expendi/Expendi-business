  end

  subgraph Clients["Provider clients (Effect layers)"]
    PRIVYA["PrivyAuth"]
    PRIVYW["PrivyWallets"]
    PAYC["Paycrest"]
    ALC["AlchemyWebhook"]
    RPC["BaseRpc"]
    FS["FileStorage"]
    MAIL["EmailSender"]
    OTP["OtpProvider"]
    PUSH["PushSender"]
    ZC["Zoho + ZohoAccessTokens<br/>+ AccountingTokenKey"]
    RX["ReceiptExtractor"]
