  AUTHS --> PRIVYA
  WALLET --> PRIVYW & ALC & RPC
  WALLET -- "refund detection" --> PAYC
  PAYOUT --> PRIVYW & PAYC & RPC
  PAYMENTS & OVER --> PAYC
  STAFF --> PAYC & RPC
  EXP --> RX
  FILES --> FS
  MAILERS --> MAIL
  PV --> OTP
  NOTIF --> PUSH
  ZOHOS --> ZC

  PRIVYA & PRIVYW --> PRIVY["Privy API"]
  PAYC --> PCAPI["Paycrest v2 API"]
  ALC --> ALAPI["Alchemy Notify API"]
  RPC --> BASEAPI["Base JSON-RPC"]
  FS --> R2["Cloudflare R2 (SigV4)<br/>off without R2_* vars"]
  MAIL --> RES["Resend<br/>fails cleanly without key"]
  OTP --> TEL["Telnyx Verify<br/>off without TELNYX_* vars"]
  PUSH --> EXPO["Expo Push"]
  ZC --> ZAPI["Zoho accounts + Books API"]
  RX --> CL["Anthropic API<br/>off without ANTHROPIC_API_KEY"]
