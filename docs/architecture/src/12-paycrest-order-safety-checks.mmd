flowchart TD
  H["Base hop delivered<br/>USDC is in the transit wallet on Base"] --> A["Approved KES payout, Paycrest"]
  A --> Q["Fresh quote for the approved KES"]
  Q -- "error or above max debit" --> F1["failed"]
  Q --> L1["Lock: still approved, not paused<br/>set orderRequestedAt"]
  L1 --> CO["Paycrest createOrder<br/>refund address = the transit wallet"]
  CO -- "transport error, 5xx or unreadable reply" --> NR1["needs_review"]
  CO -- "other error" --> F2["failed"]
  CO --> OC["order_created: order id, rate, fee,<br/>amountToTransfer, deposit address, validUntil"]
  OC --> CK{"checkOrder"}
  CK -- "any check fails" --> F3["failed<br/>unsafe: bad or own deposit address, not Base, not USDC, memo,<br/>under 120 s left, refund address not the transit wallet, not KES/KE,<br/>recipient mismatch, wrong reference, not initiated<br/>quote_changed: rate over 0.5% worse<br/>over_approved_debit: amounts or fees differ"]
  CK -- ok --> TB{"Base RPC: does the transit wallet<br/>hold amountToTransfer?"}
  TB -- "no, or balance unreadable" --> F5["failed"]
  TB -- yes --> BAR["Funding barrier under lock<br/>still order_created · not paused · checkOrder again"]
  BAR --> FUND["funding → Privy sendUsdc from the transit wallet, key payout-&lt;id&gt;"]
  FUND -- "refused (4xx)" --> F4["failed"]
  FUND -- "outcome unknown" --> NR2["needs_review"]
  FUND -- sent --> PAYING["paying + ledger debit"]
