    RECX["recorded expenses: company spending,<br/>float spending, imported claims, bills paid outside"]
    SUBC["submitted claims · float spending without receipt"]
    UNP["unpaid bills · payroll runs · recurring next_due_on"]
    LED["wallet ledger balance − reserved"]
    RATE["Paycrest live rate (USD items)"]
