# The Expendi Business API, e.g. http://localhost:3000 locally. The API must
# list this app's origin in ADMIN_APP_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:3000

# The Expendi Business Privy app (the same one the mobile app and API use).
# Add this app's origin (http://localhost:3001 locally) to the app's allowed
# domains in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: a Privy app client for the admin app, if one is set up.
# NEXT_PUBLIC_PRIVY_CLIENT_ID=
