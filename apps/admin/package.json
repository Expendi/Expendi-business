    "@expendi-business/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "catalog:",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "eslint": "catalog:",
    "postcss": "^8.5.6",
    "prettier": "catalog:",
