{
  "name": "@expendi-business/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "db:generate": "node --import tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:setup-local": "./scripts/setup-local-db.sh",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "migrate": "node dist/db/migrate-cli.js",
    "start": "node dist/index.js",
    "test": "vitest run && vitest run --config vitest.serial.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@dopplerhq/node-sdk": "^1.3.0",
    "@expendi-business/shared": "workspace:*",
    "@hono/node-server": "^1.19.17",
    "@noble/hashes": "^1.8.0",
    "@privy-io/node": "^0.37.0",
    "@simplewebauthn/server": "^13.3.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "libphonenumber-js": "^1.13.15",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@expendi-business/eslint-config": "workspace:*",
    "@expendi-business/prettier-config": "workspace:*",
    "@expendi-business/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "jose": "^6.2.14",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@expendi-business/prettier-config"
}
