# Local development only. Deployed environments load every secret from
# Doppler: set SECRETS_MANAGER=doppler and a scoped DOPPLER_TOKEN, nothing else.
SECRETS_MANAGER=env
# DOPPLER_TOKEN=
# DOPPLER_PROJECT=
# DOPPLER_CONFIG=

PORT=3000

# App role (member of expendi_business_app; never the table owner).
# Roles and databases come from `pnpm --filter @expendi-business/api db:setup-local`.
DATABASE_URL=postgres://expendi_business_api@localhost:5432/expendi_business
# Owner role, used only by `db:migrate`.
DATABASE_URL_MIGRATE=postgres://expendi_business_owner@localhost:5432/expendi_business

# The Expendi Business Privy app (not the consumer app).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: verify access tokens locally with the key from the Privy dashboard
# instead of fetching Privy's JWKS.
# PRIVY_JWT_VERIFICATION_KEY=

# Company wallets and transit wallets (docs/decisions/near-main-chain.md,
# docs/decisions/privy-wallet-policies.md). Key quorum IDs come from
# `pnpm --filter @expendi-business/api exec tsx scripts/setup-privy-keys.ts`.
# The management key's private key never goes here or in the API's Doppler config.
PRIVY_MANAGEMENT_QUORUM_ID=
PRIVY_RUNTIME_SIGNER_ID=
# The API's signer key (base64 PKCS8), from the same script. Secret.
PRIVY_RUNTIME_AUTHORIZATION_KEY=
# Per-transaction cap, whole USDC: written into each new transit wallet's
# Privy policy, and enforced by the API on each company wallet.
# WALLET_PER_TRANSACTION_MAX_USDC=3100
# Privy's ID for the Earn vault every company's Treasury uses (not the
# contract address). Unset: Treasury is unavailable to every company.
# PRIVY_EARN_VAULT_ID=

# NEAR, the main chain. NEAR_NETWORK is mainnet (the default) or testnet and
# picks the USDC contract; NEAR_RPC_URL is a JSON-RPC endpoint for the same
# network, usually with a provider API key in it.
# NEAR_NETWORK=mainnet
NEAR_RPC_URL=
# The gas relayer: one Expendi-owned Privy NEAR wallet, from
# `pnpm --filter @expendi-business/api exec tsx scripts/setup-near-relayer.ts`.
# Its account must hold NEAR before any company wallet can be set up.
NEAR_RELAYER_PRIVY_WALLET_ID=
NEAR_RELAYER_ACCOUNT_ID=

# NEAR Intents (the 1Click API): quotes for Base hops, sweeps, fund-ins and
# USDC payouts to Base and Solana. The URL defaults to the public one. The
# API key is optional and secret; it is sent as a bearer token.
# ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=

# FastNEAR Transfers API: the indexer the deposit watcher reads to find USDC
# arriving at company wallets. The URL defaults to the mainnet one. The API
# key is optional and secret; it is sent as a bearer token.
# FASTNEAR_TRANSFERS_URL=https://transfers.main.fastnear.com/v0/transfers
FASTNEAR_API_KEY=

# Base mainnet JSON-RPC (e.g. https://base-mainnet.g.alchemy.com/v2/<key>),
# used to read receipts of transfers to and from transit wallets.
BASE_RPC_URL=

# Alchemy Address Activity webhook on BASE_MAINNET, pointed at
# <api>/webhooks/alchemy. Signing key from the webhook; the notify token is
# the dashboard "Auth Token", used to add each new transit address.
ALCHEMY_WEBHOOK_ID=
ALCHEMY_WEBHOOK_SIGNING_KEY=
ALCHEMY_NOTIFY_TOKEN=

# Paycrest Sender API (no sandbox: live checks use small real amounts).
PAYCREST_API_KEY=
# Signs Paycrest's webhooks (X-Paycrest-Signature).
PAYCREST_API_SECRET=
# PAYCREST_BASE_URL=https://api.paycrest.io/v2

# Pretium, the second cash-out provider (no sandbox). Optional: without the
# API key the API still starts and Pretium cash-outs are unavailable.
PRETIUM_API_KEY=
# Signs Pretium's callbacks (x-signature-key, HMAC-SHA512 of the body).
PRETIUM_WEBHOOK_SIGNING_KEY=
# The full URL Pretium calls with a cash-out's outcome.
PRETIUM_CALLBACK_URL=
# PRETIUM_BASE_URL=https://api.xwift.africa

# Approval passkeys (spec §7.3). The relying party is the domain that hosts
# apple-app-site-association / assetlinks.json (apps/web/public/.well-known/,
# served by the web dashboard); origins are every origin the app and the
# dashboard sign from: https://<rp id>, plus android:apk-key-hash:<hash> for
# Android. Deployed: WEBAUTHN_RP_ID=business.expendi.app and WEBAUTHN_ORIGINS
# includes https://business.expendi.app, so the web dashboard can approve.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=

# Invite emails (spec §6.2) through Resend. Optional: without the key and the
# sender, invites are still created but not emailed. The sender's domain must
# be verified in Resend, with its SPF and DKIM records in DNS.
# RESEND_API_KEY=
# EMAIL_FROM=Expendi Business <team@expendi.app>
# Where the invite email sends people to install the app.
# APP_INSTALL_URL=
# The Expendi team's alert list (spec §6.16), comma-separated. Optional:
# without it, alerts are logged instead of emailed and the API still starts.
# ALERT_EMAILS=ops@expendi.app,oncall@expendi.app

# Payout phone codes (spec §6.18) through Telnyx Verify, on the Expendi
# Business Verify profile. Optional: without both, the API still starts and
# confirming a payout number answers that it isn't set up yet.
# TELNYX_API_KEY=
# TELNYX_VERIFY_PROFILE_ID=

# Push notifications (spec §6.10) go out through Expo's push API. Needed only
# once "enhanced push security" is turned on for the Expo project; without it
# the API still sends pushes.
# EXPO_ACCESS_TOKEN=

# Receipt reading (spec §6.4) with a Claude vision model. Optional: without
# the key, the API still starts and every receipt comes back as "couldn't
# read" for the employee to type in. RECEIPT_MODEL defaults to
# claude-opus-5-5; change it only on the evidence of scripts/eval-receipts.ts.
# ANTHROPIC_API_KEY=
# RECEIPT_MODEL=claude-opus-5-5

# Receipt storage (spec §6.3): a private Cloudflare R2 bucket, reached through
# presigned URLs under org/<company id>/. The API token needs object read and
# write on this bucket only. Optional: without all four, the API still starts
# and receipt uploads answer that they aren't set up yet.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# The API's public address, e.g. https://api.expendi.app. The accountant
# export's download links (spec §6.11) point here. Optional: without it,
# generating an export and the monthly export email answer that they aren't
# set up yet.
# API_PUBLIC_URL=

# Internal admin app (spec §6.15): its origins, comma-separated, may call
# /internal/* from the browser, e.g. http://localhost:3001 locally plus the
# deployed admin URL. Optional: without it, no browser origin gets CORS access.
# ADMIN_APP_ORIGINS=http://localhost:3001

# Company web dashboard (spec §6.14): its origins, comma-separated, may call
# the customer routes (/me/*, /organizations/*) from the browser, e.g.
# http://localhost:3002 locally; https://business.expendi.app deployed.
# Optional: without it, no browser origin gets CORS access to those routes.
# DASHBOARD_ORIGINS=http://localhost:3002

# Zoho Books (spec §6.17): a server-based client from https://api-console.zoho.com
# with Multi-DC on. ZOHO_REDIRECT_URI is this API's callback,
# <API>/integrations/zoho/callback, registered on the client exactly as written
# here; connect links are served beside it. ACCOUNTING_TOKEN_KEY encrypts the
# stored refresh tokens: 32 random bytes, base64 (`openssl rand -base64 32`).
# Optional: without all four, the API still starts and the Zoho connect
# endpoints answer that Zoho isn't set up.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REDIRECT_URI=http://localhost:3000/integrations/zoho/callback
# ACCOUNTING_TOKEN_KEY=

# Expendi cards, Lithic sandbox only (spec §6.25). Without the key, cards are off.
LITHIC_API_KEY=
LITHIC_WEBHOOK_SECRET=
LITHIC_ASA_SECRET=
# The HTTPS origin serving /card-reveal.
CARD_REVEAL_ORIGIN=https://business.expendi.app
