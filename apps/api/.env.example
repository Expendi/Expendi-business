# Local development only. Deployed environments load every secret from
# Doppler: set SECRETS_MANAGER=doppler and a scoped DOPPLER_TOKEN, nothing else.
SECRETS_MANAGER=env
# DOPPLER_TOKEN=
# DOPPLER_PROJECT=
# DOPPLER_CONFIG=

PORT=3000

# App role (member of expendi_business_app; never the table owner).
# Roles and databases come from `pnpm --filter @expendi-business/api db:setup-local`.
DATABASE_URL=postgres://expendi_business_api@localhost:5432/expendi_business
# Owner role, used only by `db:migrate`.
DATABASE_URL_MIGRATE=postgres://expendi_business_owner@localhost:5432/expendi_business

# The Expendi Business Privy app (not the consumer app).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: verify access tokens locally with the key from the Privy dashboard
# instead of fetching Privy's JWKS.
# PRIVY_JWT_VERIFICATION_KEY=
