{
  "name": "@expendi-business/mobile",
  "private": true,
  "main": "entrypoint.js",
  "scripts": {
    "android": "expo run:android",
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start --dev-client",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --ignore-path .gitignore",
    "ios": "expo run:ios",
    "eas-build-post-install": "pnpm --filter @expendi-business/shared build && node scripts/check-release.mjs",
    "release:check": "node scripts/check-release.mjs --production",
    "release:build:android": "pnpm dlx eas-cli build --profile production --platform android",
    "release:build:ios": "pnpm dlx eas-cli build --profile production --platform ios",
    "release:submit:android": "pnpm dlx eas-cli submit --profile production --platform android",
    "release:submit:ios": "pnpm dlx eas-cli submit --profile production --platform ios",
    "release:update": "pnpm dlx eas-cli update --channel production --environment production",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ethersproject/shims": "^5.8.0",
    "@expendi-business/shared": "workspace:*",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/metro-runtime": "~6.1.2",
    "@privy-io/expo": "0.63.6",
    "@privy-io/expo-native-extensions": "0.0.7",
    "@tanstack/react-query": "5.90.19",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.5",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.4",
    "expo-dev-client": "~6.0.16",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "fast-text-encoding": "^1.0.6",
    "lucide-react-native": "^0.575.0",
    "nativewind": "^4.2.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.2",
    "react-native-get-random-values": "^1.11.0",
    "react-native-passkeys": "0.3.3",
    "react-native-qrcode-svg": "^6.3.49",
    "react-native-reanimated": "~4.1.3",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "viem": "^2.46.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@expendi-business/eslint-config": "workspace:*",
    "@expendi-business/prettier-config": "workspace:*",
    "@expendi-business/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "~19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "^54.0.10",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "^3.4.19",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@expendi-business/prettier-config"
}
