{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./node.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist",
    "incremental": false
  },
  "include": [
    "${configDir}/src"
  ],
  "exclude": [
    "${configDir}/src/**/__tests__",
    "${configDir}/src/**/*.test.ts"
  ]
}
